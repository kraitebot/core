# hyperion fleet-metrics heartbeat — oneshot, fired by kraite-fleet-metrics.timer.
# Install to /etc/systemd/system/kraite-fleet-metrics.service
[Unit]
Description=Kraite fleet-metrics heartbeat (hyperion)
After=network-online.target redis-server.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/hyperion-fleet-report.sh
# Keep the agent cheap and bounded — it is a sub-second /proc + redis-cli pass.
TimeoutStartSec=30
Nice=10
